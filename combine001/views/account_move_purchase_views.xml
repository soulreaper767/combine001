<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BRD for Purchase Module Changes sec. 8: Vendor Bill approval
         (Draft -> Submitted -> Approved -> Posted), only shown for a
         Vendor Bill/Refund - Sales Invoices and plain journal entries
         are completely unaffected, both in the view (invisible
         otherwise) and in Python (see account_move.py's action_post
         override, scoped the same way). -->
    <record id="view_move_form_combine001_purchase_approval" model="ir.ui.view">
        <field name="name">account.move.form.combine001.purchase.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post' and @invisible=&quot;hide_post_button or move_type == 'entry' or display_inactive_currency_warning&quot;]" position="after">
                <button name="action_combine001_submit" type="object" string="Submit for Approval"
                        class="oe_highlight"
                        invisible="move_type not in ('in_invoice', 'in_refund') or x_approval_state != 'draft'"/>
                <button name="action_combine001_approve" type="object" string="Approve"
                        class="oe_highlight" groups="account.group_account_manager"
                        invisible="move_type not in ('in_invoice', 'in_refund') or x_approval_state != 'submitted'"/>
                <button name="action_combine001_reject" type="object" string="Reject"
                        groups="account.group_account_manager"
                        invisible="move_type not in ('in_invoice', 'in_refund') or x_approval_state != 'submitted'"/>
                <button name="action_combine001_reset_draft" type="object" string="Reset to Draft"
                        invisible="move_type not in ('in_invoice', 'in_refund') or x_approval_state != 'rejected'"/>
            </xpath>
            <xpath expr="//button[@name='action_post' and @invisible=&quot;hide_post_button or move_type == 'entry' or display_inactive_currency_warning&quot;]" position="before">
                <field name="x_approval_state" widget="statusbar" statusbar_visible="draft,submitted,approved"
                       invisible="move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-warning" role="alert"
                     invisible="move_type not in ('in_invoice', 'in_refund') or x_approval_state not in ('submitted', 'rejected')">
                    <field name="x_rejection_reason" nolabel="1"
                           placeholder="Rejection reason (fill in before clicking Reject, visible here once rejected)..."
                           readonly="x_approval_state != 'submitted'"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
