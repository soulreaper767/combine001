<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_agent_list" model="ir.ui.view">
        <field name="name">combine001.commission.agent.list</field>
        <field name="model">combine001.commission.agent</field>
        <field name="arch" type="xml">
            <list string="Commission Agents" editable="bottom">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="default_rate"/>
                <field name="default_base"/>
            </list>
        </field>
    </record>

    <record id="view_commission_agent_form" model="ir.ui.view">
        <field name="name">combine001.commission.agent.form</field>
        <field name="model">combine001.commission.agent</field>
        <field name="arch" type="xml">
            <form string="Commission Agent">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="default_rate"/>
                        <field name="default_base"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_agent" model="ir.actions.act_window">
        <field name="name">Commission Agents</field>
        <field name="res_model">combine001.commission.agent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
