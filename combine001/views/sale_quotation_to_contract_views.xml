<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Sales Quotation" -> "Sales Contract" relabeling. Purely cosmetic:
         renames labels/menus/buttons/report text within the core Sales
         app. Does not touch the underlying sale.order model, fields,
         states, or workflow - a "Sales Contract" here is exactly what
         Odoo calls a Quotation (a draft/sent sale.order), matching the
         textile-trade terminology Combine Spinning actually uses. -->

    <!-- Main menu / breadcrumb: Sales > Orders > Quotations -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="name">Sales Contracts</field>
    </record>
    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="name">Sales Contracts</field>
    </record>
    <!-- The sidebar menuitem itself has its OWN stored `name` field,
         copied from the action's name only once, when the menu record
         was first created (long before this module ever ran) - it does
         not live-follow the action's name afterward, so the action
         rename above alone leaves the sidebar entry still reading
         "Quotations". Must be set explicitly here too. -->
    <record id="sale.menu_sale_quotations" model="ir.ui.menu">
        <field name="name">Sales Contracts</field>
    </record>

    <!-- List view title shown when opening the Quotations action -->
    <record id="view_quotation_tree_combine001" model="ir.ui.view">
        <field name="name">sale.order.list.quotation.combine001</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">Sales Contracts</attribute>
            </list>
        </field>
    </record>

    <!-- Search filters: "My Quotations" / "Quotations" -->
    <record id="sale_order_view_search_inherit_quotation_combine001" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.quotation.combine001</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <filter name="my_quotation" position="attributes">
                <attribute name="string">My Sales Contracts</attribute>
            </filter>
            <filter name="draft" position="attributes">
                <attribute name="string">Sales Contracts</attribute>
            </filter>
        </field>
    </record>

    <!-- Form: "Set to Quotation" button + "Quotation Date" label -->
    <record id="view_order_form_combine001_contract_labels" model="ir.ui.view">
        <field name="name">sale.order.form.combine001.contract.labels</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_draft" position="attributes">
                <attribute name="string">Set to Sales Contract</attribute>
            </button>
            <xpath expr="//div[@groups='base.group_no_one' and @invisible=&quot;state in ['sale', 'cancel']&quot;]/label[@for='date_order']" position="attributes">
                <attribute name="string">Contract Date</attribute>
            </xpath>
        </field>
    </record>

    <!-- "Mark Quotation as Sent" context-menu action -->
    <record id="sale.model_sale_order_action_quotation_sent" model="ir.actions.server">
        <field name="name">Mark Sales Contract as Sent</field>
    </record>

    <!-- CRM Team "New Quotation" smart button -->
    <record id="sale.action_quotation_form" model="ir.actions.act_window">
        <field name="name">New Sales Contract</field>
    </record>

    <!-- Sales > Configuration > Quotation Templates (action + menuitem
         both have their own hardcoded `name`, same as menu_sale_quotations
         above - both need setting explicitly, not just one or the other -->
    <record id="sale_management.sale_order_template_action" model="ir.actions.act_window">
        <field name="name">Sales Contract Templates</field>
    </record>
    <record id="sale_management.sale_order_template_menu" model="ir.ui.menu">
        <field name="name">Sales Contract Templates</field>
    </record>
    <record id="sale_order_template_view_tree_combine001" model="ir.ui.view">
        <field name="name">sale.order.template.list.combine001</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_tree"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">Sales Contract Template</attribute>
            </list>
        </field>
    </record>

    <!-- Generated PDF filename. NOT overriding this action's own `name`
         field (shown in the Print dropdown): the Enterprise
         sale_pdf_quote_builder module also sets it (to "PDF Quote") and
         happens to load its data after combine001 in this install's
         module graph, silently winning the field - there's no dependency
         relationship to force a reliable order, so it's not a fight worth
         having over a rarely-seen technical action label. -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Sales Contract - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
    </record>

    <!-- PDF report body: title + date label -->
    <template id="report_saleorder_document_combine001" inherit_id="sale.report_saleorder_document">
        <xpath expr="//span[@t-elif=&quot;doc.state in ['draft','sent']&quot;]" position="replace">
            <span t-elif="doc.state in ['draft','sent']">Sales Contract # </span>
        </xpath>
        <xpath expr="//strong[@t-elif=&quot;doc.state in ['draft', 'sent']&quot;]" position="replace">
            <strong t-elif="doc.state in ['draft', 'sent']">Contract Date</strong>
        </xpath>
    </template>
</odoo>
