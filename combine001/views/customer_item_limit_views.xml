<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_item_limit_list" model="ir.ui.view">
        <field name="name">combine001.customer.item.limit.list</field>
        <field name="model">combine001.customer.item.limit</field>
        <field name="arch" type="xml">
            <list string="Customer-wise Item Quantity Limits" editable="bottom">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="max_qty"/>
            </list>
        </field>
    </record>

    <record id="view_customer_item_limit_form" model="ir.ui.view">
        <field name="name">combine001.customer.item.limit.form</field>
        <field name="model">combine001.customer.item.limit</field>
        <field name="arch" type="xml">
            <form string="Customer-wise Item Quantity Limit">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                        <field name="max_qty"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_customer_item_limit" model="ir.actions.act_window">
        <field name="name">Customer-wise Item Quantity Limits</field>
        <field name="res_model">combine001.customer.item.limit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure a maximum order quantity for a specific Customer + Product combination.
            </p>
        </field>
    </record>
</odoo>
