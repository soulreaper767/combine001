<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_charge_type_list" model="ir.ui.view">
        <field name="name">combine001.charge.type.list</field>
        <field name="model">combine001.charge.type</field>
        <field name="arch" type="xml">
            <list string="Additional Charge Types" editable="bottom">
                <field name="name"/>
                <field name="computation"/>
                <field name="default_amount"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <record id="view_charge_type_form" model="ir.ui.view">
        <field name="name">combine001.charge.type.form</field>
        <field name="model">combine001.charge.type</field>
        <field name="arch" type="xml">
            <form string="Additional Charge Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="computation"/>
                        <field name="default_amount"/>
                        <field name="product_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_charge_type" model="ir.actions.act_window">
        <field name="name">Additional Charge Types</field>
        <field name="res_model">combine001.charge.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
