<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_ledger_list" model="ir.ui.view">
        <field name="name">combine001.tax.ledger.list</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Tax General Ledger" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="move_name"/>
                <field name="partner_id"/>
                <field name="tax_line_id"/>
                <field name="name"/>
                <field name="debit" sum="Total Debit"/>
                <field name="credit" sum="Total Credit"/>
                <field name="balance" sum="Total"/>
                <field name="parent_state"/>
            </list>
        </field>
    </record>

    <record id="view_tax_ledger_search" model="ir.ui.view">
        <field name="name">combine001.tax.ledger.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search string="Tax General Ledger">
                <field name="tax_line_id"/>
                <field name="partner_id"/>
                <field name="move_name"/>
                <filter string="Posted" name="posted" domain="[('parent_state', '=', 'posted')]"/>
                <group>
                    <filter string="Tax" name="group_tax" context="{'group_by': 'tax_line_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tax_ledger" model="ir.actions.act_window">
        <field name="name">Tax General Ledger</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('tax_line_id', '!=', False)]</field>
        <field name="context">{'search_default_posted': 1, 'search_default_group_tax': 1}</field>
        <field name="search_view_id" ref="view_tax_ledger_search"/>
    </record>
</odoo>
