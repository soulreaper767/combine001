<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_combine001" model="ir.module.category">
        <field name="name">Combine001</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_combine001" model="res.groups.privilege">
        <field name="name">Combine001 Roles</field>
        <field name="category_id" ref="module_category_combine001"/>
    </record>

    <record id="group_tax_officer" model="res.groups">
        <field name="name">Tax Officer</field>
        <field name="privilege_id" ref="privilege_combine001"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="comment">Maintains tax templates/rates and the Tax General Ledger. May be combined with the Accountant role in smaller teams.</field>
    </record>

    <record id="group_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="privilege_id" ref="privilege_combine001"/>
        <field name="comment">Read-only access across Combine001 sales/tax/commission data for audit and compliance review.</field>
    </record>

    <!-- Auditor: read-only record rules on every Combine001 model -->
    <record id="rule_auditor_customer_item_limit" model="ir.rule">
        <field name="name">Combine001 Auditor: Customer Item Limit (read only)</field>
        <field name="model_id" ref="model_combine001_customer_item_limit"/>
        <field name="groups" eval="[(4, ref('group_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_auditor_charge_type" model="ir.rule">
        <field name="name">Combine001 Auditor: Charge Type (read only)</field>
        <field name="model_id" ref="model_combine001_charge_type"/>
        <field name="groups" eval="[(4, ref('group_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_auditor_commission_agent" model="ir.rule">
        <field name="name">Combine001 Auditor: Commission Agent (read only)</field>
        <field name="model_id" ref="model_combine001_commission_agent"/>
        <field name="groups" eval="[(4, ref('group_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_auditor_commission_line" model="ir.rule">
        <field name="name">Combine001 Auditor: Commission Line (read only)</field>
        <field name="model_id" ref="model_combine001_commission_line"/>
        <field name="groups" eval="[(4, ref('group_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_auditor_tax_adjustment" model="ir.rule">
        <field name="name">Combine001 Auditor: Tax Adjustment (read only)</field>
        <field name="model_id" ref="model_combine001_tax_adjustment"/>
        <field name="groups" eval="[(4, ref('group_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
